# Токен бота из @BotFather (создайте бота командой /newbot)
VITE_TELEGRAM_BOT_TOKEN=

# ID чата, куда будут приходить заявки.
# Напишите боту любое сообщение, затем откройте:
# https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
# и возьмите значение chat.id из ответа.
VITE_TELEGRAM_CHAT_ID=

# Режим аудита сайта на /audit: mock (по умолчанию, без сетевых запросов) или live.
# Не включайте live, пока не подключен боевой API.
VITE_AUDIT_MODE=mock
# Адрес API аудита. По умолчанию https://api.gabulyan-tigran.ru, менять не нужно.
# VITE_AUDIT_API_URL=https://api.gabulyan-tigran.ru
