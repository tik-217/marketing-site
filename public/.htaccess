RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]

# Кэш. Файлы с хешем в имени (/assets/) лежат год. HTML-страницы (адрес без расширения, корень и .html)
# браузер каждый раз сверяет с сервером, поэтому вернувшийся посетитель видит свежую версию.
SetEnvIf Request_URI "^/assets/" HASHED_ASSET
SetEnvIf Request_URI "(^/$|/[^/.]*$|\.html$)" HTML_PAGE
<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  Header always set Cache-Control "no-cache" env=HTML_PAGE
  Header always set Cache-Control "no-cache" env=REDIRECT_HTML_PAGE
</IfModule>

# Постоянные ссылки на отчеты: не индексировать и не передавать адрес ссылки как Referer.
# После внутреннего перенаправления на /index.html переменная окружения получает префикс REDIRECT_, поэтому проверяются оба имени.
SetEnvIf Request_URI "^/audit/report/" REPORT_PAGE
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=REPORT_PAGE
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=REDIRECT_REPORT_PAGE
  Header always set Referrer-Policy "no-referrer" env=REPORT_PAGE
  Header always set Referrer-Policy "no-referrer" env=REDIRECT_REPORT_PAGE
  Header always set Cache-Control "no-store" env=REPORT_PAGE
  Header always set Cache-Control "no-store" env=REDIRECT_REPORT_PAGE
</IfModule>
